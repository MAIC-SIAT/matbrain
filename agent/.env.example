# Placeholder backend configuration for Mat-T1 / Mat-R1.
# Shared fallback endpoint (OpenAI-compatible, e.g. a vLLM server) used when a
# role below leaves its own *_BASE_URL / *_API_KEY blank.
LLM_API_KEY=
LLM_BASE_URL=

# Model names served by the executor (Mat-T1) and reasoner (Mat-R1) endpoints.
MAT_T1_MODEL=
MAT_R1_MODEL=

# Mat-MCP SSE endpoints (live on the host).
MCP_MAT_QUERY_URL=http://localhost:5667/sse
MCP_MATGL_URL=http://localhost:5668/sse
MCP_CRYSTALLM_URL=http://localhost:5669/sse
MCP_MATTERGEN_URL=http://localhost:5670/sse
MCP_PYMATGEN_URL=http://localhost:5672/pymatgen/sse

# Agent runtime knobs.
MAX_ITERATIONS=6
TOOL_CALL_TIMEOUT=480
LOG_LEVEL=INFO
